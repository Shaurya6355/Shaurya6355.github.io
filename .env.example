# All optional. Every value here ends up in public client code — never put secrets in NEXT_PUBLIC_ variables.

# Public URL of the deployed site (canonical links, social cards, sitemap).
# e.g. https://your-project.vercel.app  or  https://shaurya6355.github.io
NEXT_PUBLIC_SITE_URL=

# Only when hosting under a sub-path, e.g. /portfolio for https://user.github.io/portfolio/
NEXT_PUBLIC_BASE_PATH=

# Optional, cookie-free analytics (https://www.goatcounter.com, free for personal sites).
# e.g. https://your-code.goatcounter.com/count — leave empty to disable.
NEXT_PUBLIC_GOATCOUNTER_URL=

# Set to 1 to show the yellow "To add" review markers in a production build (for proofreading).
NEXT_PUBLIC_SHOW_REVIEW_NOTES=
