{
  "name": "shaurya-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:links": "node scripts/check-links.mjs",
    "check:content": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-content.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run check:links",
    "preview": "node scripts/serve-out.mjs 3100",
    "export:text": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/export-text.mjs",
    "apply:text": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/apply-text.mjs"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
